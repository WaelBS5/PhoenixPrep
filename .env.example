# ---------------------------------------------------------------------------
# PhoenixPrep environment variables
# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# LLM provider (OpenRouter) ---------------------------------------------------
# API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model slug to use, e.g. openai/gpt-4-turbo, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4-turbo

# Phoenix MCP (HG Insights) ---------------------------------------------------
# Full JSON-RPC MCP endpoint URL for your Phoenix API key.
# If left blank (or containing "YOUR_API_KEY"), the app falls back to mock data.
MCP_ENDPOINT=https://phoenix.hginsights.com/api/ai/YOUR_API_KEY/mcp
